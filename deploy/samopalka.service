[Unit]
Description=Samopalka 3.4 multiplayer game server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=samopalka
Group=samopalka
WorkingDirectory=/opt/samopalka
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
Environment=DEBUG_TOOLS=1
Environment=NODE_OPTIONS=--max-old-space-size=160
ExecStart=/usr/bin/node /opt/samopalka/apps/server/dist/index.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
