# Copy to .env in the project root. Never commit your actual .env.
# Local admin testing: keep HOST=127.0.0.1 and set ADMIN_ALLOW_HTTP=1.
HOST=127.0.0.1
PORT=3000

# At least 12 characters; empty disables admin access.
# Quote values containing spaces or #. Set your own strong password.
ADMIN_PASSWORD=
# HTTPS required by default. Use 1 only for local HTTP testing.
ADMIN_ALLOW_HTTP=1

# Closed beta: 1 enables the host test panel. Public server: set 0.
DEBUG_TOOLS=1
# Turn timers, in seconds (1–600).
TURN_SECONDS=60
SHORT_TURN_SECONDS=60

# Optional absolute path to persistent balance data.
# Empty uses <project>/data/balance.json.
BALANCE_FILE=
